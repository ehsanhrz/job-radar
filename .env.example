# Copy to .env and fill in:  cp .env.example .env

# ── Telegram (required) ─────────────────────────────────────
# 1. Talk to @BotFather -> /newbot -> copy the token here
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. Send /start to your new bot, then run:  python -m jobradar chat-id
TELEGRAM_CHAT_ID=123456789
# The bot ignores every chat except TELEGRAM_CHAT_ID, and in it only you.
# Only needed if TELEGRAM_CHAT_ID is a GROUP: comma-separated user ids allowed to use it.
TELEGRAM_ALLOWED_USER_IDS=

# Optional: proxy for Telegram API calls (only if your VPN isn't system-wide)
# e.g. socks5h://127.0.0.1:10808  or  http://127.0.0.1:10809
TELEGRAM_PROXY=

# ── Scraping (optional) ─────────────────────────────────────
# Comma-separated proxies for LinkedIn/Indeed (residential proxies help a lot
# if you get blocked). Formats: host:port  |  user:pass@host:port
SCRAPE_PROXIES=

# ── AI second opinion (optional) ────────────────────────────
# Any OpenAI-compatible provider. Leave AI_API_KEY empty to disable.
# If the key is wrong/banned/rate-limited, jobs just keep their keyword score.
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1         AI_MODEL=openai/gpt-oss-120b
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1           AI_MODEL=<any model id ending in :free>
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   AI_MODEL=<a Flash model>
#   Cerebras:   AI_BASE_URL=https://api.cerebras.ai/v1             AI_MODEL=<see their model list>
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# A few lines about you (skills, domain, constraints). Kept out of the repo on purpose.
AI_PROFILE=

# ── Paths (defaults are fine) ───────────────────────────────
JOBRADAR_CONFIG=config.yaml
JOBRADAR_DB=data/jobradar.db
