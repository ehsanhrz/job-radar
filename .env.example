# Copy to .env and fill in:  cp .env.example .env

# ── Telegram (required) ─────────────────────────────────────
# 1. Talk to @BotFather -> /newbot -> copy the token here
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. Send /start to your new bot, then run:  python -m jobradar chat-id
TELEGRAM_CHAT_ID=123456789

# Optional: proxy for Telegram API calls (only if your VPN isn't system-wide)
# e.g. socks5h://127.0.0.1:10808  or  http://127.0.0.1:10809
TELEGRAM_PROXY=

# ── Scraping (optional) ─────────────────────────────────────
# Comma-separated proxies for LinkedIn/Indeed (residential proxies help a lot
# if you get blocked). Formats: host:port  |  user:pass@host:port
SCRAPE_PROXIES=

# ── Paths (defaults are fine) ───────────────────────────────
JOBRADAR_CONFIG=config.yaml
JOBRADAR_DB=data/jobradar.db
